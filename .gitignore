# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
storybook-static/
*.tsbuildinfo

# Emitted artifacts that should never live next to source
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
apps/api/src/**/*.d.ts.map
apps/mobile/app/**/*.js
apps/mobile/app/**/*.js.map
apps/mobile/app/**/*.d.ts
apps/mobile/app/**/*.d.ts.map
apps/mobile/src/**/*.js
apps/mobile/src/**/*.js.map
apps/mobile/src/**/*.d.ts
apps/mobile/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/ui/vite.config.js
packages/ui/vite.config.js.map
packages/ui/vite.config.d.ts
packages/ui/vite.config.d.ts.map

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store

# Synth runtime state (derived; canonical config lives in .synth/manifest.json)
.synth/data/
.synth/cache/

# Expo
.expo/
expo-env.d.ts

# Transient mobile build artifacts (emitted JS/d.ts next to source)
apps/mobile/app/**/*.js
apps/mobile/app/**/*.d.ts
apps/mobile/src/**/*.js
apps/mobile/src/**/*.d.ts

# IDE
.vscode/
.idea/

# Testing
coverage/

# Turbo
.turbo/

# Supabase
supabase/.temp/

# Ephemeral CLI documentation projection. Ignore only while it remains an
